#!/bin/sh
set -eu

pid_file=/run/x4-dhcp.pid
config_file=/etc/x4-dhcp/dnsmasq.conf

case "${1:-}" in
  start)
    mkdir -p /run /tmp
    if [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then exit 0; fi
    rm -f "$pid_file"
    dnsmasq --conf-file="$config_file" --pid-file="$pid_file"
    sleep 1
    [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")"
    ;;
  stop)
    if [ -s "$pid_file" ]; then kill "$(cat "$pid_file")" 2>/dev/null || true; fi
    rm -f "$pid_file"
    ;;
  status)
    [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
    ;;
  *) echo "usage: x4-dhcp-service {start|stop|status}" >&2; exit 64 ;;
esac
