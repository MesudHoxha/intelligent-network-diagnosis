{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X3-R0 Layer 2 and VLAN Design and Runtime Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "track",
    "source_boundary",
    "compatibility",
    "source_bindings",
    "topology_design",
    "baseline_signature",
    "l2_vlan_scope",
    "feature_boundary",
    "release_sequence",
    "safety_invariants",
    "evidence_policy",
    "acceptance",
    "claim_boundary",
    "runtime_authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"const": "x3_r0_layer2_vlan_design_runtime_gate_v1"},
    "status": {"const": "ACCEPTED_DESIGN_ONLY"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_gate", "phase9_status", "current_release", "next_release"],
      "properties": {
        "parent_gate": {"const": "x2_r5_addressing_closeout_v1"},
        "phase9_status": {"const": "P9_R1_PAUSED_BY_USER"},
        "current_release": {"const": "X3_R0_LAYER2_VLAN_DESIGN_GATE"},
        "next_release": {"const": "X3_R1_WRONG_ACCESS_VLAN"}
      }
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_commit", "extension_policy", "runtime_inherited"],
      "properties": {
        "parent_commit": {"const": "7949418dca284a064165f77e2e40f626ea54daba"},
        "extension_policy": {"const": "APPEND_ONLY"},
        "runtime_inherited": {"const": false}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_baseline_mutation_allowed",
        "accepted_x2_mutation_allowed",
        "accepted_result_mutation_allowed",
        "api_v1_status",
        "future_extended_api",
        "truth_model"
      ],
      "properties": {
        "frozen_baseline_mutation_allowed": {"const": false},
        "accepted_x2_mutation_allowed": {"const": false},
        "accepted_result_mutation_allowed": {"const": false},
        "api_v1_status": {"const": "FROZEN_BASELINE"},
        "future_extended_api": {"const": "/api/v2"},
        "truth_model": {"const": "SINGLE_FAULT_ONLY"}
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "topology_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_path",
        "topology_id",
        "status",
        "switch_plane",
        "container_image",
        "node_count",
        "link_count",
        "baseline_vlans",
        "controlled_vlan_values",
        "flow_roles",
        "required_raw_observations"
      ],
      "properties": {
        "context_path": {"const": "labs/topologies/x3_r1_l2_vlan/topology_context_v1.json"},
        "topology_id": {"const": "X3_TOP_01_L2_VLAN"},
        "status": {"const": "DESIGN_ONLY"},
        "switch_plane": {"const": "LINUX_BRIDGE_VLAN_FILTERING"},
        "container_image": {"const": "ind-linux:0.1"},
        "node_count": {"const": 6},
        "link_count": {"const": 5},
        "baseline_vlans": {"const": [10, 99]},
        "controlled_vlan_values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wrong_access_vlan", "mismatched_native_vlan"],
          "properties": {
            "wrong_access_vlan": {"const": 20},
            "mismatched_native_vlan": {"const": 98}
          }
        },
        "flow_roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/flowRole"}
        },
        "required_raw_observations": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upperIdentifier"}
        }
      }
    },
    "baseline_signature": {"$ref": "#/$defs/featureSignature"},
    "l2_vlan_scope": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/faultSlice"}
    },
    "feature_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "collector_id",
        "collector_version",
        "collector_status",
        "required_feature_ids"
      ],
      "properties": {
        "catalog_id": {"const": "x1_feature_catalog_v1"},
        "collector_id": {"const": "l2_vlan_state_collector"},
        "collector_version": {"const": 1},
        "collector_status": {"const": "DESIGN_ONLY"},
        "required_feature_ids": {
          "const": [
            "access_vlan_matches_expected",
            "vlan_exists_on_target",
            "vlan_allowed_on_trunk",
            "native_vlan_matches_peer",
            "fdb_location_matches_expected"
          ]
        }
      }
    },
    "release_sequence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/release"}
    },
    "safety_invariants": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/upperIdentifier"}
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_contract",
        "raw_artifact_hash_required",
        "collector_provenance_required",
        "real_evidence_required_per_runtime_slice",
        "connectivity_only_classification_forbidden",
        "r0_creates_empirical_evidence",
        "accepted_x2_evidence_read_only",
        "report_only_test_access_allowed"
      ],
      "properties": {
        "evidence_contract": {"const": "Evidence v4"},
        "raw_artifact_hash_required": {"const": true},
        "collector_provenance_required": {"const": true},
        "real_evidence_required_per_runtime_slice": {"const": true},
        "connectivity_only_classification_forbidden": {"const": true},
        "r0_creates_empirical_evidence": {"const": false},
        "accepted_x2_evidence_read_only": {"const": true},
        "report_only_test_access_allowed": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_runtime_executed",
        "new_empirical_claim_created",
        "topology_context_validated",
        "unit_tests_required",
        "integration_tests_required",
        "infrastructure_e2e_required_for_r0",
        "existing_infrastructure_regression_required",
        "frozen_artifacts_unchanged",
        "explicit_gate_before_each_runtime_release"
      ],
      "properties": {
        "new_runtime_executed": {"const": false},
        "new_empirical_claim_created": {"const": false},
        "topology_context_validated": {"const": true},
        "unit_tests_required": {"const": true},
        "integration_tests_required": {"const": true},
        "infrastructure_e2e_required_for_r0": {"const": false},
        "existing_infrastructure_regression_required": {"const": true},
        "frozen_artifacts_unchanged": {"const": true},
        "explicit_gate_before_each_runtime_release": {"const": true}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proves", "does_not_prove"],
      "properties": {
        "proves": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "does_not_prove": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime_authorization": {"$ref": "#/$defs/runtimeAuthorization"}
  },
  "$defs": {
    "lowerIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "upperIdentifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "path", "sha256"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/lowerIdentifier"},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "featureSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_vlan_matches_expected",
        "vlan_exists_on_target",
        "vlan_allowed_on_trunk",
        "native_vlan_matches_peer",
        "fdb_location_matches_expected"
      ],
      "properties": {
        "access_vlan_matches_expected": {"type": "boolean"},
        "vlan_exists_on_target": {"type": "boolean"},
        "vlan_allowed_on_trunk": {"type": "boolean"},
        "native_vlan_matches_peer": {"type": "boolean"},
        "fdb_location_matches_expected": {"type": "boolean"}
      }
    },
    "flowRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "source", "destination", "vlan_id", "trunk_encoding"],
      "properties": {
        "flow_id": {"$ref": "#/$defs/lowerIdentifier"},
        "source": {"$ref": "#/$defs/lowerIdentifier"},
        "destination": {"$ref": "#/$defs/lowerIdentifier"},
        "vlan_id": {"type": "integer", "minimum": 1, "maximum": 4094},
        "trunk_encoding": {"enum": ["TAGGED", "UNTAGGED_NATIVE"]}
      }
    },
    "faultSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "fault_code",
        "fault_type",
        "category",
        "implementation_release",
        "planned_rule_id",
        "injector_mechanism",
        "restoration_mechanism",
        "required_feature_ids",
        "fault_signature",
        "required_evidence_modes",
        "excluded_confounders",
        "recovery_intent_required",
        "idempotent_restoration_required",
        "real_e2e_required"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 4},
        "fault_code": {"pattern": "^B[2-5]$"},
        "fault_type": {"$ref": "#/$defs/lowerIdentifier"},
        "category": {"const": "l2_vlan"},
        "implementation_release": {"$ref": "#/$defs/upperIdentifier"},
        "planned_rule_id": {"$ref": "#/$defs/upperIdentifier"},
        "injector_mechanism": {"$ref": "#/$defs/lowerIdentifier"},
        "restoration_mechanism": {"$ref": "#/$defs/lowerIdentifier"},
        "required_feature_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lowerIdentifier"}
        },
        "fault_signature": {"$ref": "#/$defs/featureSignature"},
        "required_evidence_modes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upperIdentifier"}
        },
        "excluded_confounders": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lowerIdentifier"}
        },
        "recovery_intent_required": {"const": true},
        "idempotent_restoration_required": {"const": true},
        "real_e2e_required": {"const": true}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "objective", "status", "runtime_inherited"],
      "properties": {
        "release_id": {"$ref": "#/$defs/upperIdentifier"},
        "objective": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACCEPTED_DESIGN_ONLY", "PLANNED"]},
        "runtime_inherited": {"const": false}
      }
    },
    "runtimeAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerlab_execution",
        "network_mutation",
        "new_evidence_collection",
        "dataset_generation",
        "model_fit_or_selection",
        "estimator_deserialization",
        "method_prediction",
        "metric_calculation",
        "report_only_test_access",
        "multiple_fault_execution"
      ],
      "properties": {
        "containerlab_execution": {"const": false},
        "network_mutation": {"const": false},
        "new_evidence_collection": {"const": false},
        "dataset_generation": {"const": false},
        "model_fit_or_selection": {"const": false},
        "estimator_deserialization": {"const": false},
        "method_prediction": {"const": false},
        "metric_calculation": {"const": false},
        "report_only_test_access": {"const": false},
        "multiple_fault_execution": {"const": false}
      }
    }
  }
}
