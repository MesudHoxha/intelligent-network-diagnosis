{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/p8_thesis_evaluation_synthesis_v1.schema.json",
  "title": "P8-R2 Thesis Evaluation Synthesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthesis_id",
    "status",
    "parent_checkpoint",
    "accepted_sources",
    "evaluation_design",
    "comparison",
    "findings",
    "claim_matrix",
    "blocked_claims",
    "assets",
    "source_integrity",
    "runtime_authorization",
    "next_milestone"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "synthesis_id": {"const": "p8_r2_thesis_evaluation_synthesis_v1"},
    "status": {"const": "THESIS_READY"},
    "parent_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "commit_short"],
      "properties": {
        "branch": {"const": "main"},
        "commit": {"const": "c55c803dbb42752f1597b2276026204267e35e0f"},
        "commit_short": {"const": "c55c803"}
      }
    },
    "accepted_sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "evaluation_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_class_count",
        "complete_context_count",
        "clean_dataset_row_count",
        "split_row_counts",
        "evaluation_input_counts",
        "deterministic_mask_count",
        "method_count",
        "report_only_test_attempt_count",
        "masked_input_independence"
      ],
      "properties": {
        "diagnostic_class_count": {"const": 6},
        "complete_context_count": {"const": 6},
        "clean_dataset_row_count": {"const": 72},
        "split_row_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"const": 36},
            "validation": {"const": 12},
            "test": {"const": 24}
          }
        },
        "evaluation_input_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean", "masked", "overall"],
          "properties": {
            "clean": {"const": 24},
            "masked": {"const": 96},
            "overall": {"const": 120}
          }
        },
        "deterministic_mask_count": {"const": 4},
        "method_count": {"const": 3},
        "report_only_test_attempt_count": {"const": 1},
        "masked_input_independence": {"const": "TRANSFORMATIONS_NOT_INDEPENDENT_EXPERIMENTS"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "comparison_type",
        "method_order",
        "scopes",
        "metric_order",
        "methods",
        "statistical_superiority_test",
        "display_percentage_policy"
      ],
      "properties": {
        "comparison_id": {"const": "p6_r6_rules_ml_hybrid_report_only_comparison_v1"},
        "comparison_type": {"const": "DESCRIPTIVE_ONLY"},
        "method_order": {
          "const": ["rule_based_p6_v1", "machine_learning_p6_v1", "hybrid_p6_v1"]
        },
        "scopes": {"const": ["clean", "masked_overall", "overall"]},
        "metric_order": {
          "const": [
            "accuracy",
            "macro_f1",
            "coverage",
            "exact_diagnosis_rate",
            "affected_prefix_rate",
            "insufficient_evidence_rate",
            "abstention_rate"
          ]
        },
        "methods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_based_p6_v1", "machine_learning_p6_v1", "hybrid_p6_v1"],
          "properties": {
            "rule_based_p6_v1": {"$ref": "#/$defs/methodScopes"},
            "machine_learning_p6_v1": {"$ref": "#/$defs/methodScopes"},
            "hybrid_p6_v1": {"$ref": "#/$defs/methodScopes"}
          }
        },
        "statistical_superiority_test": {"const": "NOT_PERFORMED"},
        "display_percentage_policy": {"const": "UNIT_FRACTIONS_MULTIPLIED_BY_100_AND_ROUNDED_ONLY_FOR_LABELS"}
      }
    },
    "findings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/finding"}
    },
    "claim_matrix": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/claim"}
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/blockedClaim"}
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/asset"}
    },
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p8_r0_scope_hash_verified_against_p8_r1_registry",
        "p8_r1_registry_hash_verified_against_receipt",
        "private_archive_sha256",
        "runtime_artifact_count",
        "estimator_deserialized"
      ],
      "properties": {
        "p8_r0_scope_hash_verified_against_p8_r1_registry": {"const": true},
        "p8_r1_registry_hash_verified_against_receipt": {"const": true},
        "private_archive_sha256": {"const": "e9eea5fe520779eee4f4eba4df442ae46c0fd43ea382eed9f5ad5de94cbd14b6"},
        "runtime_artifact_count": {"const": 1488},
        "estimator_deserialized": {"const": false}
      }
    },
    "runtime_authorization": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "additionalProperties": {"const": false}
    },
    "next_milestone": {"const": "P8-R3"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unitRate": {"type": "number", "minimum": 0, "maximum": 1},
    "sourceBinding": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "gate_id": {"const": "p8_r0_evidence_claim_scope_v1"},
        "registry_id": {"const": "p8_r1_final_evidence_registry_v1"},
        "receipt_id": {"const": "p8_r1_private_archive_receipt_v1"}
      },
      "oneOf": [
        {"required": ["gate_id"]},
        {"required": ["registry_id"]},
        {"required": ["receipt_id"]}
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "accuracy",
        "macro_f1",
        "coverage",
        "exact_diagnosis_rate",
        "affected_prefix_rate",
        "insufficient_evidence_rate",
        "abstention_rate"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "accuracy": {"$ref": "#/$defs/unitRate"},
        "macro_f1": {"$ref": "#/$defs/unitRate"},
        "coverage": {"$ref": "#/$defs/unitRate"},
        "exact_diagnosis_rate": {"$ref": "#/$defs/unitRate"},
        "affected_prefix_rate": {"$ref": "#/$defs/unitRate"},
        "insufficient_evidence_rate": {"$ref": "#/$defs/unitRate"},
        "abstention_rate": {"$ref": "#/$defs/unitRate"}
      }
    },
    "methodScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "masked_overall", "overall"],
      "properties": {
        "clean": {"$ref": "#/$defs/metrics"},
        "masked_overall": {"$ref": "#/$defs/metrics"},
        "overall": {"$ref": "#/$defs/metrics"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "claim_ids", "statement", "limit"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^FND0[1-5]$"},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C0[1-8]$"}},
        "statement": {"type": "string", "minLength": 1},
        "limit": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "status", "statement", "evidence_ids", "limit"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C0[1-8]$"},
        "status": {"const": "SUPPORTED_BOUNDED"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E0[1-6]$"}},
        "limit": {"type": "string", "minLength": 1}
      }
    },
    "blockedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^B0[1-8]$"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "path", "sha256", "size_bytes", "title"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[TF]0[1-3]$"},
        "kind": {"enum": ["CSV_TABLE", "SVG_FIGURE"]},
        "path": {"type": "string", "pattern": "^docs/thesis_assets/phase8/P8_R2_"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
