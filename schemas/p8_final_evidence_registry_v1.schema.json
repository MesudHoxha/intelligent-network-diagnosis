{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p8_final_evidence_registry_v1.schema.json",
  "title": "P8 Final Evidence Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "status",
    "archive_scope",
    "source_checkpoint",
    "accepted_roots",
    "runtime_artifact_count",
    "runtime_payload_size_bytes",
    "raw_experiment_count",
    "runtime_artifacts",
    "public_source_binding_count",
    "public_source_bindings",
    "p7_projection_catalog",
    "p8_scope_gate",
    "archive_layout",
    "integrity",
    "runtime_authorization",
    "excluded_from_private_runtime_archive",
    "next_milestone"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "p8_r1_final_evidence_registry_v1"},
    "status": {"const": "ACCEPTED_IMMUTABLE"},
    "archive_scope": {"const": "FINAL_P6_R5_TO_P6_R6_EXPERIMENTAL_CHAIN"},
    "source_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "accepted_roots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root_id", "path", "sha256", "size_bytes"],
        "properties": {
          "root_id": {"type": "string", "pattern": "^R[0-9]{2}$"},
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "runtime_artifact_count": {"type": "integer", "minimum": 31},
    "runtime_payload_size_bytes": {"type": "integer", "minimum": 1},
    "raw_experiment_count": {"const": 72},
    "runtime_artifacts": {
      "type": "array",
      "minItems": 31,
      "items": {"$ref": "#/$defs/runtime_artifact"}
    },
    "public_source_binding_count": {"type": "integer", "minimum": 11},
    "public_source_bindings": {
      "type": "array",
      "minItems": 11,
      "items": {"$ref": "#/$defs/public_binding"}
    },
    "p7_projection_catalog": {"$ref": "#/$defs/artifact"},
    "p8_scope_gate": {"$ref": "#/$defs/artifact"},
    "archive_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "registry_member",
        "readme_member",
        "runtime_prefix",
        "archive_file_name",
        "deterministic_metadata"
      ],
      "properties": {
        "directory": {"const": "P8_R1_FINAL_EVIDENCE_ARCHIVE_V1"},
        "registry_member": {"const": "REGISTRY.json"},
        "readme_member": {"const": "README.md"},
        "runtime_prefix": {"const": "artifacts/"},
        "archive_file_name": {"const": "P8-R1-final-evidence-private.tar.gz"},
        "deterministic_metadata": {
          "const": {"file_mode": "0644", "gid": 0, "mtime": 0, "uid": 0}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "missing_or_drifted_artifact",
        "estimator_handling",
        "test_partition_handling",
        "archive_rebuild"
      ],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "missing_or_drifted_artifact": {"const": "FAIL_CLOSED"},
        "estimator_handling": {"const": "OPAQUE_BYTES_HASHED_AND_COPIED_NOT_DESERIALIZED"},
        "test_partition_handling": {"const": "HASHED_AND_COPIED_WITHOUT_EVALUATION"},
        "archive_rebuild": {"const": "DETERMINISTIC_FROM_REGISTRY_AND_ACCEPTED_BYTES"}
      }
    },
    "runtime_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerlab",
        "network_mutation",
        "diagnosis_execution",
        "model_deserialization",
        "model_refit",
        "policy_reselection",
        "test_evaluation",
        "metric_recalculation",
        "new_metric",
        "accepted_artifact_mutation"
      ],
      "properties": {
        "containerlab": {"const": false},
        "network_mutation": {"const": false},
        "diagnosis_execution": {"const": false},
        "model_deserialization": {"const": false},
        "model_refit": {"const": false},
        "policy_reselection": {"const": false},
        "test_evaluation": {"const": false},
        "metric_recalculation": {"const": false},
        "new_metric": {"const": false},
        "accepted_artifact_mutation": {"const": false}
      }
    },
    "excluded_from_private_runtime_archive": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "reason"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_milestone": {"const": "P8-R2"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "commit_short", "public_archive"],
      "properties": {
        "branch": {"const": "main"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_short": {"type": "string", "pattern": "^[0-9a-f]{7}$"},
        "public_archive": {"const": "GIT_TRACKED_SOURCE_AT_CHECKPOINT"}
      }
    },
    "runtime_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size_bytes",
        "archive_path",
        "stage",
        "role",
        "archive_member"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^A[0-9]{4}$"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "archive_path": {"type": "string", "pattern": "^artifacts/"},
        "stage": {"enum": ["P6-R5", "P6-R6"]},
        "role": {"type": "string", "minLength": 1},
        "archive_member": {"const": true}
      }
    },
    "public_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "size_bytes", "archive_member"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "archive_member": {"const": false}
      }
    }
  }
}
