{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X4-R6 DHCP/DNS/Service Security Evidence Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "source_commit", "created_at_utc", "evidence_kind", "runs", "summary"],
