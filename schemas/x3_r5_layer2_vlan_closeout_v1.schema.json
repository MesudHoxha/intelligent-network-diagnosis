{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X3-R5 Layer 2/VLAN Closeout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "status", "track", "source_boundary", "source_bindings", "accepted_slices", "evidence_receipt", "compatibility", "claim_boundary", "runtime_authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"const": "x3_r5_layer2_vlan_closeout_v1"},
    "status": {"const": "ACCEPTED_SOURCE_CLOSEOUT"},
    "track": {"type": "object"}, "source_boundary": {"type": "object"},
    "source_bindings": {"type": "array", "minItems": 18, "maxItems": 18},
    "accepted_slices": {"type": "array", "minItems": 4, "maxItems": 4},
    "evidence_receipt": {"type": "object"}, "compatibility": {"type": "object"}, "claim_boundary": {"type": "object"},
    "runtime_authorization": {"type": "object", "additionalProperties": {"const": false}, "minProperties": 10, "maxProperties": 10}
  }
}
