{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Mask Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "catalog_id",
    "status",
    "mask_identity_is_predictor",
    "allowed_partitions",
    "masks"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "plan_id": {"$ref": "#/$defs/identifier"},
    "catalog_id": {"$ref": "#/$defs/identifier"},
    "status": {"const": "ACCEPTED_CONTRACT_ONLY"},
    "mask_identity_is_predictor": {"const": false},
    "allowed_partitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["validation", "report_only_test"]}
    },
    "masks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mask"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mask_id", "description", "feature_ids"],
      "properties": {
        "mask_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
