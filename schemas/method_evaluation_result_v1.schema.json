{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Method Evaluation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "generated_at_utc",
    "status",
    "method",
    "dataset_binding",
    "provenance",
    "evaluation_policy",
    "partitions",
    "overall",
    "records",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "$ref": "#/$defs/identifier"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "COMPLETED"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "dataset_binding": {
      "$ref": "#/$defs/dataset_binding"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "evaluation_policy": {
      "$ref": "#/$defs/evaluation_policy"
    },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test"
      ],
      "properties": {
        "train": {
          "$ref": "#/$defs/partition_summary"
        },
        "validation": {
          "$ref": "#/$defs/partition_summary"
        },
        "test": {
          "$ref": "#/$defs/partition_summary"
        }
      }
    },
    "overall": {
      "$ref": "#/$defs/overall_summary"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluation_record"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "family",
        "implementation_id",
        "trained",
        "selection_statement"
      ],
      "properties": {
        "method_id": {
          "enum": [
            "rule_based",
            "machine_learning",
            "hybrid"
          ]
        },
        "family": {
          "enum": [
            "traditional",
            "machine_learning",
            "hybrid"
          ]
        },
        "implementation_id": {
          "$ref": "#/$defs/identifier"
        },
        "trained": {
          "type": "boolean"
        },
        "selection_statement": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "partition_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "row_count",
        "group_count",
        "group_ids"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_run_id",
        "dataset_row_schema_version",
        "merged_dataset",
        "split"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/identifier"
        },
        "campaign_run_id": {
          "$ref": "#/$defs/identifier"
        },
        "dataset_row_schema_version": {
          "const": 2
        },
        "merged_dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "row_count"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/non_empty_string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "row_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "seed",
            "ratios",
            "manifest_path",
            "manifest_sha256",
            "partitions",
            "no_cross_partition_group"
          ],
          "properties": {
            "algorithm": {
              "const": "complete_context_group_hash_v2"
            },
            "seed": {
              "type": "integer"
            },
            "ratios": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "train",
                "validation",
                "test"
              ],
              "properties": {
                "train": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "validation": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "test": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            },
            "manifest_path": {
              "$ref": "#/$defs/non_empty_string"
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "partitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "train",
                "validation",
                "test"
              ],
              "properties": {
                "train": {
                  "$ref": "#/$defs/partition_binding"
                },
                "validation": {
                  "$ref": "#/$defs/partition_binding"
                },
                "test": {
                  "$ref": "#/$defs/partition_binding"
                }
              }
            },
            "no_cross_partition_group": {
              "const": true
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_result",
        "rule_audit",
        "split_manifest",
        "input_record_count",
        "artifact_reference_count"
      ],
      "properties": {
        "campaign_result": {
          "$ref": "#/$defs/artifact_reference"
        },
        "rule_audit": {
          "$ref": "#/$defs/artifact_reference"
        },
        "split_manifest": {
          "$ref": "#/$defs/artifact_reference"
        },
        "input_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_reference_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "class_order",
        "primary_metric",
        "reported_classification_metrics",
        "zero_division_policy",
        "selection_partitions",
        "held_out_partition",
        "test_use",
        "overall_use"
      ],
      "properties": {
        "target": {
          "const": "fault_type"
        },
        "class_order": {
          "const": [
            "no_fault",
            "missing_static_route",
            "wrong_next_hop"
          ]
        },
        "primary_metric": {
          "const": "macro_f1"
        },
        "reported_classification_metrics": {
          "const": [
            "accuracy",
            "macro_precision",
            "macro_recall",
            "macro_f1",
            "per_class_precision",
            "per_class_recall",
            "per_class_f1",
            "confusion_matrix"
          ]
        },
        "zero_division_policy": {
          "const": 0.0
        },
        "selection_partitions": {
          "const": [
            "train",
            "validation"
          ]
        },
        "held_out_partition": {
          "const": "test"
        },
        "test_use": {
          "const": "report_only"
        },
        "overall_use": {
          "const": "descriptive_only"
        }
      }
    },
    "class_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "true_positive",
        "false_positive",
        "false_negative",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "support": {
          "type": "integer",
          "minimum": 0
        },
        "true_positive": {
          "type": "integer",
          "minimum": 0
        },
        "false_positive": {
          "type": "integer",
          "minimum": 0
        },
        "false_negative": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/rate"
        },
        "recall": {
          "$ref": "#/$defs/rate"
        },
        "f1": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "classification_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "correct_count",
        "accuracy",
        "macro",
        "per_class",
        "confusion_matrix",
        "zero_division_policy"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "correct_count": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy": {
          "$ref": "#/$defs/rate"
        },
        "macro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "recall",
            "f1"
          ],
          "properties": {
            "precision": {
              "$ref": "#/$defs/rate"
            },
            "recall": {
              "$ref": "#/$defs/rate"
            },
            "f1": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "per_class": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_fault",
            "missing_static_route",
            "wrong_next_hop"
          ],
          "properties": {
            "no_fault": {
              "$ref": "#/$defs/class_metrics"
            },
            "missing_static_route": {
              "$ref": "#/$defs/class_metrics"
            },
            "wrong_next_hop": {
              "$ref": "#/$defs/class_metrics"
            }
          }
        },
        "confusion_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actual_labels",
            "predicted_labels",
            "values"
          ],
          "properties": {
            "actual_labels": {
              "const": [
                "no_fault",
                "missing_static_route",
                "wrong_next_hop"
              ]
            },
            "predicted_labels": {
              "const": [
                "no_fault",
                "missing_static_route",
                "wrong_next_hop"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "zero_division_policy": {
          "const": 0.0
        }
      }
    },
    "diagnostic_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_count",
        "correct_count",
        "rate"
      ],
      "properties": {
        "applicable_count": {
          "type": "integer",
          "minimum": 0
        },
        "correct_count": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "metrics_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "diagnostic_checks"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/classification_metrics"
        },
        "diagnostic_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_diagnosis_match",
            "affected_prefix_fault_only"
          ],
          "properties": {
            "exact_diagnosis_match": {
              "$ref": "#/$defs/diagnostic_check"
            },
            "affected_prefix_fault_only": {
              "$ref": "#/$defs/diagnostic_check"
            }
          }
        }
      }
    },
    "partition_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use",
        "row_count",
        "group_count",
        "group_ids",
        "metrics"
      ],
      "properties": {
        "use": {
          "enum": [
            "development",
            "selection",
            "report_only"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics_summary"
        }
      }
    },
    "overall_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use",
        "row_count",
        "metrics"
      ],
      "properties": {
        "use": {
          "const": "descriptive_only"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "metrics": {
          "$ref": "#/$defs/metrics_summary"
        }
      }
    },
    "evaluation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "partition",
        "split_group_id",
        "expected_fault_type",
        "predicted_fault_type",
        "classification_correct",
        "exact_match",
        "affected_prefix_correct",
        "artifacts"
      ],
      "properties": {
        "sample_id": {
          "$ref": "#/$defs/identifier"
        },
        "partition": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "split_group_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_fault_type": {
          "$ref": "#/$defs/fault_type"
        },
        "predicted_fault_type": {
          "$ref": "#/$defs/fault_type"
        },
        "classification_correct": {
          "type": "boolean"
        },
        "exact_match": {
          "type": "boolean"
        },
        "affected_prefix_correct": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "experiment_manifest",
            "ground_truth",
            "evidence",
            "prediction",
            "evaluation"
          ],
          "properties": {
            "experiment_manifest": {
              "$ref": "#/$defs/artifact_reference"
            },
            "ground_truth": {
              "$ref": "#/$defs/artifact_reference"
            },
            "evidence": {
              "$ref": "#/$defs/artifact_reference"
            },
            "prediction": {
              "$ref": "#/$defs/artifact_reference"
            },
            "evaluation": {
              "$ref": "#/$defs/artifact_reference"
            }
          }
        }
      }
    },
    "fault_type": {
      "enum": [
        "no_fault",
        "missing_static_route",
        "wrong_next_hop"
      ]
    }
  }
}
