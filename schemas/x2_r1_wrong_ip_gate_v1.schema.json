{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X2-R1 Wrong IP Address Runtime Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "track",
    "source_boundary",
    "source_bindings",
    "compatibility",
    "slice",
    "collector_activation",
    "safety",
    "acceptance",
    "runtime_authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"const": "x2_r1_wrong_ip_address_runtime_gate_v1"},
    "status": {"const": "IMPLEMENTED_RUNTIME_SLICE"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_gate", "current_release", "next_release", "phase9_status"],
      "properties": {
        "parent_gate": {"const": "x2_r0_addressing_design_runtime_gate_v1"},
        "current_release": {"const": "X2_R1_WRONG_IP_ADDRESS"},
        "next_release": {"const": "X2_R2_WRONG_SUBNET_MASK"},
        "phase9_status": {"const": "P9_R1_PAUSED_BY_USER"}
      }
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_commit", "extension_policy", "runtime_inherited"],
      "properties": {
        "parent_commit": {"const": "2b3ee4d08c9dea4da4e5820e6d41130f6218b57f"},
        "extension_policy": {"const": "APPEND_ONLY"},
        "runtime_inherited": {"const": false}
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "path", "sha256"],
        "properties": {
          "binding_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "compatibility": {"type": "object"},
    "slice": {"type": "object"},
    "collector_activation": {"type": "object"},
    "safety": {"type": "object"},
    "acceptance": {"type": "object"},
    "runtime_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerlab_execution",
        "network_mutation",
        "new_evidence_collection",
        "dataset_generation",
        "model_fit_or_selection",
        "estimator_deserialization",
        "method_prediction",
        "metric_calculation",
        "report_only_test_access",
        "multiple_fault_execution"
      ],
      "properties": {
        "containerlab_execution": {"type": "boolean"},
        "network_mutation": {"type": "boolean"},
        "new_evidence_collection": {"type": "boolean"},
        "dataset_generation": {"type": "boolean"},
        "model_fit_or_selection": {"type": "boolean"},
        "estimator_deserialization": {"type": "boolean"},
        "method_prediction": {"type": "boolean"},
        "metric_calculation": {"type": "boolean"},
        "report_only_test_access": {"type": "boolean"},
        "multiple_fault_execution": {"type": "boolean"}
      }
    }
  }
}

