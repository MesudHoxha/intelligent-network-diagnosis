    "sourceBoundary": {"type": "object", "additionalProperties": false, "required": ["parent_commit", "extension_policy", "runtime_inherited"], "properties": {"parent_commit": {"const": "2a763c6c6cd44f984ce08331e20d3e03445a0037"}, "extension_policy": {"const": "APPEND_ONLY"}, "runtime_inherited": {"const": false}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["frozen_baseline_mutation_allowed", "accepted_x2_mutation_allowed", "accepted_x3_mutation_allowed", "accepted_result_mutation_allowed", "api_v1_status", "future_extended_api", "truth_model"], "properties": {"frozen_baseline_mutation_allowed": {"const": false}, "accepted_x2_mutation_allowed": {"const": false}, "accepted_x3_mutation_allowed": {"const": false}, "accepted_result_mutation_allowed": {"const": false}, "api_v1_status": {"const": "FROZEN_BASELINE"}, "future_extended_api": {"const": "/api/v2"}, "truth_model": {"const": "SINGLE_FAULT_ONLY"}}},
