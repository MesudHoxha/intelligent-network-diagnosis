    "acceptance": {"type": "object", "additionalProperties": false, "required": ["new_runtime_executed", "new_empirical_claim_created", "topology_context_validated", "unit_tests_required", "integration_tests_required", "infrastructure_e2e_required_for_r0", "existing_infrastructure_regression_required", "frozen_artifacts_unchanged", "explicit_gate_before_each_runtime_release"], "properties": {"new_runtime_executed": {"const": false}, "new_empirical_claim_created": {"const": false}, "topology_context_validated": {"const": true}, "unit_tests_required": {"const": true}, "integration_tests_required": {"const": true}, "infrastructure_e2e_required_for_r0": {"const": false}, "existing_infrastructure_regression_required": {"const": true}, "frozen_artifacts_unchanged": {"const": true}, "explicit_gate_before_each_runtime_release": {"const": true}}},
