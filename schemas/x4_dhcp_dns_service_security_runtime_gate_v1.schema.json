    "faultSlice": {"type": "object", "additionalProperties": false, "required": ["order", "fault_code", "fault_type", "category", "implementation_release", "planned_rule_id", "injector_mechanism", "restoration_mechanism", "required_feature_ids", "fault_signature", "required_evidence_modes", "excluded_confounders", "recovery_intent_required", "idempotent_restoration_required", "real_e2e_required"], "properties": {"order": {"type": "integer", "minimum": 1, "maximum": 5}, "fault_code": {"enum": ["D1", "D2", "D3", "D4", "E2"]}, "fault_type": {"$ref": "#/$defs/lowerIdentifier"}, "category": {"enum": ["services", "security"]}, "implementation_release": {"$ref": "#/$defs/upperIdentifier"}, "planned_rule_id": {"$ref": "#/$defs/upperIdentifier"}, "injector_mechanism": {"$ref": "#/$defs/lowerIdentifier"}, "restoration_mechanism": {"$ref": "#/$defs/lowerIdentifier"}, "required_feature_ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/lowerIdentifier"}}, "fault_signature": {"$ref": "#/$defs/signature"}, "required_evidence_modes": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/upperIdentifier"}}, "excluded_confounders": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/lowerIdentifier"}}, "recovery_intent_required": {"const": true}, "idempotent_restoration_required": {"const": true}, "real_e2e_required": {"const": true}}},
    "featureBoundary": {"type": "object", "additionalProperties": false, "required": ["catalog_id", "required_feature_ids", "collector_bindings"], "properties": {"catalog_id": {"const": "x1_feature_catalog_v1"}, "required_feature_ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/lowerIdentifier"}}, "collector_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["collector_id", "collector_version", "collector_status", "feature_ids"], "properties": {"collector_id": {"$ref": "#/$defs/lowerIdentifier"}, "collector_version": {"const": 1}, "collector_status": {"const": "DESIGN_ONLY"}, "feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/lowerIdentifier"}}}}}}},
