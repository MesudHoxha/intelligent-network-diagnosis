{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelligent-network-diagnosis:schema:batch-plan:v1",
  "title": "Batch Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "execution",
        "entries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "failure_policy"
          ],
          "properties": {
            "order": {
              "const": "listed"
            },
            "failure_policy": {
              "const": "stop"
            }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_id",
              "scenario_path",
              "repetitions"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "scenario_path": {
                "type": "string",
                "pattern": "^scenarios/[A-Za-z0-9_./-]+\\.ya?ml$",
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              },
              "repetitions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      }
    }
  }
}
