{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 6 Independent Method Freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "freeze_id", "created_at_utc", "protocol",
    "accepted_p6_r5", "implementation", "development_artifacts",
    "selected_ml_candidate", "selected_hybrid_policy", "software",
    "test_inputs_read", "test_predictions_or_metrics", "refit_after_test"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "freeze_id": {"const": "p6_r6_six_class_method_freeze_v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "protocol": {"$ref": "#/$defs/artifact"},
    "accepted_p6_r5": {"type": "object"},
    "implementation": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "development_artifacts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "selected_ml_candidate": {"type": "string", "minLength": 1},
    "selected_hybrid_policy": {"type": "string", "minLength": 1},
    "software": {"type": "object", "additionalProperties": {"type": "string"}},
    "test_inputs_read": {"const": 0},
    "test_predictions_or_metrics": {"const": "ABSENT"},
    "refit_after_test": {"const": "PROHIBITED"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
