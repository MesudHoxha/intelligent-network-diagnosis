{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-Fault Diagnosis Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "input_vector_id",
    "method",
    "truth_model",
    "status",
    "prediction",
    "ranked_candidates",
    "evidence_assessment",
    "explanation_refs"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "result_id": {"$ref": "#/$defs/identifier"},
    "input_vector_id": {"$ref": "#/$defs/identifier"},
    "method": {"enum": ["rule_based_v2", "ml_v2", "hybrid_v2"]},
    "truth_model": {"const": "single_fault"},
    "status": {"enum": ["diagnosed", "abstained", "insufficient_evidence"]},
    "prediction": {
      "oneOf": [
        {"$ref": "#/$defs/candidate"},
        {"type": "null"}
      ]
    },
    "ranked_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness_ratio", "conflict_detected", "missing_domains"],
      "properties": {
        "completeness_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict_detected": {"type": "boolean"},
        "missing_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "explanation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fault_type", "score", "location", "affected_resource"],
      "properties": {
        "fault_type": {"$ref": "#/$defs/identifier"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "location": {"type": ["string", "null"], "minLength": 1},
        "affected_resource": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
