{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P7-R1 Accepted Artifact Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "contract_id",
    "status",
    "integrity_model",
    "artifact_count",
    "root_artifact_ids",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "p7_r1_accepted_artifact_catalog_v1"},
    "contract_id": {"const": "p7_readonly_dashboard_api_v1"},
    "status": {"const": "ACCEPTED_IMMUTABLE"},
    "integrity_model": {
      "const": "GIT_TRACKED_CATALOG_BINDS_ALL_PROJECTION_SOURCES"
    },
    "artifact_count": {"const": 15},
    "root_artifact_ids": {
      "const": [
        "freeze_manifest",
        "freeze_receipt",
        "run_manifest",
        "cross_method_comparison"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "role", "sha256", "size_bytes"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^(data|models|reports)/",
            "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
          },
          "role": {
            "enum": [
              "accepted_gate",
              "accepted_root",
              "selection",
              "case_source",
              "target_source",
              "prediction_source",
              "method_report"
            ]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
