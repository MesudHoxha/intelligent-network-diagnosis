{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cross_method_comparison_v1.schema.json",
  "title": "Cross-Method Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "generated_at_utc",
    "status",
    "method_order",
    "dataset_binding",
    "report_references",
    "hybrid_selection",
    "comparison_policy",
    "partitions",
    "overall",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_id": {"const": "p5_r2_rules_ml_hybrid_comparison_v1"},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "status": {"const": "COMPLETED"},
    "method_order": {
      "type": "array",
      "prefixItems": [
        {"const": "rule_based"},
        {"const": "machine_learning"},
        {"const": "hybrid"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "dataset_binding": {"$ref": "#/$defs/dataset_binding"},
    "report_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_based", "machine_learning", "hybrid"],
      "properties": {
        "rule_based": {"$ref": "#/$defs/artifact_reference"},
        "machine_learning": {"$ref": "#/$defs/artifact_reference"},
        "hybrid": {"$ref": "#/$defs/artifact_reference"}
      }
    },
    "hybrid_selection": {"$ref": "#/$defs/artifact_reference"},
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "class_order",
        "primary_metric",
        "selection_partitions",
        "held_out_partition",
        "held_out_group_id",
        "test_use",
        "overall_use",
        "test_influenced_policy_or_selection",
        "statistical_superiority_test_performed"
      ],
      "properties": {
        "target": {"const": "fault_type"},
        "class_order": {
          "type": "array",
          "prefixItems": [
            {"const": "no_fault"},
            {"const": "missing_static_route"},
            {"const": "wrong_next_hop"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "primary_metric": {"const": "macro_f1"},
        "selection_partitions": {
          "type": "array",
          "prefixItems": [
            {"const": "train"},
            {"const": "validation"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "held_out_partition": {"const": "test"},
        "held_out_group_id": {"const": "CTX_G02_TOP02_CHAIN_3R"},
        "test_use": {"const": "report_only"},
        "overall_use": {"const": "descriptive_only"},
        "test_influenced_policy_or_selection": {"const": false},
        "statistical_superiority_test_performed": {"const": false}
      }
    },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"$ref": "#/$defs/partition_comparison"},
        "validation": {"$ref": "#/$defs/partition_comparison"},
        "test": {"$ref": "#/$defs/partition_comparison"}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "row_count", "methods"],
      "properties": {
        "use": {"const": "descriptive_only"},
        "row_count": {"const": 30},
        "methods": {"$ref": "#/$defs/method_comparisons"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/non_empty_string"}
    }
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "method_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy",
        "macro_precision",
        "macro_recall",
        "macro_f1",
        "exact_diagnosis_rate",
        "affected_prefix_fault_only_rate",
        "coverage",
        "abstention_count",
        "abstention_rate"
      ],
      "properties": {
        "accuracy": {"$ref": "#/$defs/rate"},
        "macro_precision": {"$ref": "#/$defs/rate"},
        "macro_recall": {"$ref": "#/$defs/rate"},
        "macro_f1": {"$ref": "#/$defs/rate"},
        "exact_diagnosis_rate": {"$ref": "#/$defs/rate"},
        "affected_prefix_fault_only_rate": {"$ref": "#/$defs/rate"},
        "coverage": {"$ref": "#/$defs/rate"},
        "abstention_count": {"type": "integer", "minimum": 0},
        "abstention_rate": {"$ref": "#/$defs/rate"}
      }
    },
    "method_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "metrics"],
      "properties": {
        "method_id": {"enum": ["rule_based", "machine_learning", "hybrid"]},
        "metrics": {"$ref": "#/$defs/method_metrics"}
      }
    },
    "method_comparisons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/method_comparison"}
    },
    "partition_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "row_count", "group_count", "group_ids", "methods"],
      "properties": {
        "use": {"enum": ["development", "selection", "report_only"]},
        "row_count": {"type": "integer", "minimum": 1},
        "group_count": {"type": "integer", "minimum": 1},
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "methods": {"$ref": "#/$defs/method_comparisons"}
      }
    },
    "partition_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row_count", "group_count", "group_ids"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "group_count": {"type": "integer", "minimum": 1},
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "campaign_run_id", "dataset_row_schema_version", "merged_dataset", "split"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/identifier"},
        "campaign_run_id": {"$ref": "#/$defs/identifier"},
        "dataset_row_schema_version": {"const": 2},
        "merged_dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "row_count"],
          "properties": {
            "path": {"$ref": "#/$defs/non_empty_string"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "row_count": {"const": 30}
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "seed", "ratios", "manifest_path", "manifest_sha256", "partitions", "no_cross_partition_group"],
          "properties": {
            "algorithm": {"const": "complete_context_group_hash_v2"},
            "seed": {"type": "integer"},
            "ratios": {
              "type": "object",
              "additionalProperties": false,
              "required": ["train", "validation", "test"],
              "properties": {
                "train": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                "validation": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                "test": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
              }
            },
            "manifest_path": {"$ref": "#/$defs/non_empty_string"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "partitions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["train", "validation", "test"],
              "properties": {
                "train": {"$ref": "#/$defs/partition_binding"},
                "validation": {"$ref": "#/$defs/partition_binding"},
                "test": {"$ref": "#/$defs/partition_binding"}
              }
            },
            "no_cross_partition_group": {"const": true}
          }
        }
      }
    }
  }
}
