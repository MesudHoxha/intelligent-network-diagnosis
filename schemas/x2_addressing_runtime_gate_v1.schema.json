{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X2-R0 Addressing Design and Runtime Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "track",
    "compatibility",
    "source_bindings",
    "baseline_signature",
    "addressing_scope",
    "feature_boundary",
    "release_sequence",
    "safety_invariants",
    "evidence_policy",
    "acceptance",
    "runtime_authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"const": "x2_r0_addressing_design_runtime_gate_v1"},
    "status": {"const": "ACCEPTED_DESIGN_ONLY"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_x1_gate",
        "phase9_status",
        "current_release",
        "next_release"
      ],
      "properties": {
        "source_x1_gate": {
          "const": "x1_extended_contracts_modular_collection_v1"
        },
        "phase9_status": {"const": "P9_R1_PAUSED_BY_USER"},
        "current_release": {"const": "X2_R0_ADDRESSING_DESIGN_GATE"},
        "next_release": {"const": "X2_R1_WRONG_IP_ADDRESS"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_policy",
        "frozen_baseline_mutation_allowed",
        "accepted_result_mutation_allowed",
        "api_v1_status",
        "future_extended_api",
        "truth_model"
      ],
      "properties": {
        "extension_policy": {"const": "APPEND_ONLY"},
        "frozen_baseline_mutation_allowed": {"const": false},
        "accepted_result_mutation_allowed": {"const": false},
        "api_v1_status": {"const": "FROZEN_BASELINE"},
        "future_extended_api": {"const": "/api/v2"},
        "truth_model": {"const": "SINGLE_FAULT_ONLY"}
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "baseline_signature": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 7
    },
    "addressing_scope": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/faultSlice"}
    },
    "feature_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "collector_id",
        "collector_version",
        "collector_status",
        "required_feature_ids"
      ],
      "properties": {
        "catalog_id": {"const": "x1_feature_catalog_v1"},
        "collector_id": {"const": "addressing_state_collector"},
        "collector_version": {"const": 1},
        "collector_status": {"const": "DESIGN_ONLY"},
        "required_feature_ids": {
          "const": [
            "source_address_matches_expected",
            "source_prefix_matches_expected",
            "source_default_route_present",
            "duplicate_address_detected",
            "duplicate_address_mac_churn_detected"
          ]
        }
      }
    },
    "release_sequence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/release"}
    },
    "safety_invariants": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_contract",
        "raw_artifact_hash_required",
        "collector_provenance_required",
        "real_evidence_required_per_runtime_slice",
        "r0_creates_empirical_evidence",
        "accepted_baseline_sources_read_only",
        "report_only_test_access_allowed"
      ],
      "properties": {
        "evidence_contract": {"const": "Evidence v4"},
        "raw_artifact_hash_required": {"const": true},
        "collector_provenance_required": {"const": true},
        "real_evidence_required_per_runtime_slice": {"const": true},
        "r0_creates_empirical_evidence": {"const": false},
        "accepted_baseline_sources_read_only": {"const": true},
        "report_only_test_access_allowed": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_runtime_executed",
        "new_empirical_claim_created",
        "unit_tests_required",
        "integration_tests_required",
        "infrastructure_e2e_required_for_r0",
        "existing_infrastructure_regression_required",
        "frozen_artifacts_unchanged",
        "explicit_gate_before_each_runtime_release"
      ],
      "properties": {
        "new_runtime_executed": {"const": false},
        "new_empirical_claim_created": {"const": false},
        "unit_tests_required": {"const": true},
        "integration_tests_required": {"const": true},
        "infrastructure_e2e_required_for_r0": {"const": false},
        "existing_infrastructure_regression_required": {"const": true},
        "frozen_artifacts_unchanged": {"const": true},
        "explicit_gate_before_each_runtime_release": {"const": true}
      }
    },
    "runtime_authorization": {"$ref": "#/$defs/runtimeAuthorization"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_]*$"
    },
    "lowerIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "path", "sha256"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/lowerIdentifier"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "faultSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "fault_code",
        "fault_type",
        "category",
        "implementation_release",
        "planned_rule_id",
        "injector_mechanism",
        "restoration_mechanism",
        "required_feature_ids",
        "fault_signature",
        "required_evidence_modes",
        "excluded_confounders",
        "recovery_intent_required",
        "idempotent_restoration_required",
        "real_e2e_required"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 4},
        "fault_code": {"enum": ["A1", "A2", "C3", "A4"]},
        "fault_type": {"$ref": "#/$defs/lowerIdentifier"},
        "category": {"enum": ["addressing", "routing"]},
        "implementation_release": {"$ref": "#/$defs/identifier"},
        "planned_rule_id": {"$ref": "#/$defs/identifier"},
        "injector_mechanism": {"$ref": "#/$defs/lowerIdentifier"},
        "restoration_mechanism": {"$ref": "#/$defs/lowerIdentifier"},
        "required_feature_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lowerIdentifier"}
        },
        "fault_signature": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {"type": "boolean"}
        },
        "required_evidence_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "excluded_confounders": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lowerIdentifier"}
        },
        "recovery_intent_required": {"const": true},
        "idempotent_restoration_required": {"const": true},
        "real_e2e_required": {"const": true}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "objective", "status", "runtime_inherited"],
      "properties": {
        "release_id": {"$ref": "#/$defs/identifier"},
        "objective": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACCEPTED_DESIGN_ONLY", "PLANNED"]},
        "runtime_inherited": {"const": false}
      }
    },
    "runtimeAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerlab_execution",
        "network_mutation",
        "new_evidence_collection",
        "dataset_generation",
        "model_fit_or_selection",
        "estimator_deserialization",
        "method_prediction",
        "metric_calculation",
        "report_only_test_access",
        "multiple_fault_execution"
      ],
      "properties": {
        "containerlab_execution": {"const": false},
        "network_mutation": {"const": false},
        "new_evidence_collection": {"const": false},
        "dataset_generation": {"const": false},
        "model_fit_or_selection": {"const": false},
        "estimator_deserialization": {"const": false},
        "method_prediction": {"const": false},
        "metric_calculation": {"const": false},
        "report_only_test_access": {"const": false},
        "multiple_fault_execution": {"const": false}
      }
    }
  }
}
