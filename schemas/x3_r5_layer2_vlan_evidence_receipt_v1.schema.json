{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X3-R5 Layer 2/VLAN Evidence Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "source_commit", "created_at_utc", "runs", "summary"],
  "properties": {
    "schema_version": {"const": 1}, "receipt_id": {"const": "x3_r5_layer2_vlan_evidence_receipt_v1"},
    "source_commit": {"const": "7bddd3abebb9b987cbb98d22977884a5cd161acf"}, "created_at_utc": {"type": "string", "format": "date-time"},
    "runs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["release_id", "fault_type", "rule_id", "relative_run_path", "run_tree_sha256", "artifacts"], "properties": {"release_id": {"type": "string"}, "fault_type": {"type": "string"}, "rule_id": {"type": "string"}, "relative_run_path": {"type": "string", "pattern": "^data/raw/"}, "run_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifacts": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}}}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["run_count", "all_completed", "all_diagnosed", "all_restored", "all_baselines_valid", "all_raw_hashes_verified"], "properties": {"run_count": {"const": 4}, "all_completed": {"const": true}, "all_diagnosed": {"const": true}, "all_restored": {"const": true}, "all_baselines_valid": {"const": true}, "all_raw_hashes_verified": {"const": true}}}
  }
}
