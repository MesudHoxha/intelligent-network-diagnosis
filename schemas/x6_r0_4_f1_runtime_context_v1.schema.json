{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "topology", "image", "traffic", "qdisc", "windows", "features", "effectiveness", "rule", "rerun_policy", "authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"const": "X6_R0_4_F1_RUNTIME_PARAMETER_FREEZE"},
    "topology": {"type": "object"},
    "image": {"type": "object"},
    "traffic": {"type": "object"},
    "qdisc": {"type": "object"},
    "windows": {"type": "object"},
    "features": {"type": "array", "minItems": 6, "maxItems": 6},
    "effectiveness": {"type": "object"},
    "rule": {"type": "object"},
    "rerun_policy": {"type": "object"},
    "authorization": {"type": "object"}
  }
}
